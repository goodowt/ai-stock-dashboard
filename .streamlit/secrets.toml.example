# 이 파일을 복사해 .streamlit/secrets.toml 로 저장한 뒤 실제 값을 입력하세요.
# secrets.toml 파일 자체는 .gitignore에 의해 Git에 커밋되지 않습니다.

KIS_APP_KEY = "your_app_key_here"
KIS_APP_SECRET = "your_app_secret_here"

# AI 투자의견의 실적·공시 분석에 쓰는 OPEN DART 키 (https://opendart.fss.or.kr 에서 무료 발급).
# 없어도 앱은 동작하며, 그 경우 밸류에이션·기술적 지표만으로 의견을 냅니다.
DART_API_KEY = "your_dart_api_key_here"
